{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Fleet-owned frozen validation slice of the official Argo CD v3.4.5 Application CRD (https://raw.githubusercontent.com/argoproj/argo-cd/v3.4.5/manifests/crds/application-crd.yaml). It intentionally covers only the Application fields used by this fleet.",
  "description": "Pinned, hand-reduced fleet slice of the official Argo CD v3.4.5 Application CRD: https://raw.githubusercontent.com/argoproj/argo-cd/v3.4.5/manifests/crds/application-crd.yaml.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "argoproj.io/v1alpha1" },
    "kind": { "const": "Application" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["project", "destination", "syncPolicy"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/source" },
          "allOf": [
            {
              "if": {
                "contains": {
                  "properties": {
                    "helm": {
                      "properties": { "valueFiles": { "contains": { "type": "string", "pattern": "^\\$" } } },
                      "required": ["valueFiles"]
                    }
                  },
                  "required": ["helm"]
                }
              },
              "then": {
                "contains": {
                  "properties": { "ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
                  "required": ["ref"]
                }
              }
            }
          ]
        },
        "destination": { "$ref": "#/$defs/destination" },
        "syncPolicy": { "$ref": "#/$defs/syncPolicy" }
      },
      "oneOf": [{ "required": ["source"] }, { "required": ["sources"] }],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["name", "namespace"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "labels": { "type": "object" },
        "finalizers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["repoURL", "targetRevision"],
      "properties": {
        "repoURL": { "type": "string", "minLength": 1 },
        "targetRevision": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "directory": {
          "type": "object",
          "properties": { "recurse": { "type": "boolean" }, "include": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "helm": {
          "type": "object",
          "properties": {
            "valueFiles": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^\\$[A-Za-z][A-Za-z0-9-]*(?:/.*)?$" }
            },
            "values": { "type": "string", "minLength": 1 }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["server", "namespace"],
      "properties": {
        "server": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "syncPolicy": {
      "type": "object",
      "properties": {
        "automated": {
          "type": "object",
          "required": ["prune", "selfHeal"],
          "properties": { "prune": { "type": "boolean" }, "selfHeal": { "type": "boolean" } },
          "additionalProperties": false
        },
        "syncOptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*=.*$" }
        }
      },
      "anyOf": [{ "required": ["automated"] }, { "required": ["syncOptions"] }],
      "additionalProperties": false
    }
  }
}
