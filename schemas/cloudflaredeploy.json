{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "const": "CloudflareDeploy" },
    "metadata": { "type": "object", "required": ["name"] },
    "spec": {
      "type": "object",
      "required": ["scriptName", "desiredVersionFrom", "pin"],
      "properties": {
        "scriptName": { "type": "string" },
        "desiredVersionFrom": {
          "type": "object",
          "required": ["tag"],
          "properties": { "tag": { "type": "string" } },
          "additionalProperties": false
        },
        "rollout": {
          "type": "object",
          "required": ["strategy", "steps"],
          "properties": {
            "strategy": { "const": "gradual" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["percent"],
                "properties": {
                  "percent": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "soak": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*(s|m|h|d)$"
                  }
                },
                "additionalProperties": false
              },
              "contains": {
                "type": "object",
                "required": ["percent"],
                "properties": { "percent": { "const": 100 } }
              }
            }
          },
          "additionalProperties": false
        },
        "pin": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
