{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string" },
    "kind": { "const": "Platform" },
    "metadata": { "type": "object", "required": ["name", "namespace"] },
    "spec": {
      "type": "object",
      "required": ["infisical", "sos", "pipeline"],
      "properties": {
        "infisical": {
          "type": "object",
          "required": ["projectSlug", "serviceFolders"],
          "properties": {
            "projectSlug": { "type": "string", "minLength": 1 },
            "serviceFolders": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "sos": {
          "type": "object",
          "required": ["register"],
          "properties": { "register": { "type": "boolean" } },
          "additionalProperties": false
        },
        "pipeline": {
          "type": "object",
          "required": ["stages"],
          "properties": {
            "stages": {
              "type": "array",
              "description": "Ordered pipeline DAG derived 1:1 from carbon platform.yaml; each step is a landscape name, an object, or a [parallel, set].",
              "items": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
