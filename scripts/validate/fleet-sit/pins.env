# Exact upstream inputs for the throwaway fleet system-integration test.
#
# Argo CD source tag v3.4.5 resolves to the commit below. The install manifest
# checksum was calculated from the raw tag URL.
ARGOCD_VERSION=v3.4.5
ARGOCD_SOURCE_COMMIT=564b94973b284b8de98da7cee6eeade2cb941e46
ARGOCD_MANIFEST_URL=https://raw.githubusercontent.com/argoproj/argo-cd/v3.4.5/manifests/install.yaml
ARGOCD_MANIFEST_SHA256=cdf6758b489d25641c2a1fd835642543aaa64fe530867d0136a83ddf3dafe456

# Namespace substrate. These reviewed inputs are enforced both by the outer
# lifecycle and by the on-instance worker before application mutation.
NSC_CLI_VERSION=v0.0.532
NSC_CLI_COMMIT=8fd20e2be4ee9d72b1357fa6f8ff2e15629abc96
NSC_INSTANCE_ID_PATTERN='^[a-z0-9]{13}$'
NSC_DURATION=2h
NSC_DURATION_SECONDS=7200
NSC_MACHINE_TYPE=16x32
NSC_VCPU=16
NSC_MEMORY_MEGABYTES=32768
NSC_MACHINE_ARCH=amd64
NSC_MACHINE_OS=linux
NSC_INSTANCE_OS_ID=wolfi
NSC_KUBERNETES_VERSION=1.33
NSC_KUBERNETES_DISTRIBUTION=k3s
NSC_K3S_VERSION=v1.33.1+k3s1
NSC_NODE_COUNT=1
NSC_LABEL_NODE_KEY=ratchet-node
NSC_LABEL_NODE_VALUE=fleet
NSC_LABEL_GENERATION_KEY=ratchet-generation
NSC_LABEL_GENERATION_VALUE=7
NSC_PURPOSE='fleet full L0-L9 Namespace built-in-k3s proof'
NSC_CONTAINERD_CTR=/vendor/containerd/ctr
NSC_CONTAINERD_ADDRESS=/var/run/containerd/containerd.sock
NSC_CONTAINERD_NAMESPACE=k8s.io

# Kargo v1.9.10 — the SAME pinned release the repository already consumes for
# the promotion-engine integration test (scripts/validate/kargo-yaml-update
# go.mod) and the frozen Warehouse validation slice (schemas/warehouse.json).
# The annotated tag v1.9.10 resolves to the commit below, so these are the real
# upstream CRDs of the pinned release rather than a locally rewritten copy.
KARGO_VERSION=v1.9.10
KARGO_SOURCE_COMMIT=07183012e350cf8c3921574c26aeda8e6dd944ec
KARGO_CRD_BASE_URL=https://raw.githubusercontent.com/akuity/kargo/07183012e350cf8c3921574c26aeda8e6dd944ec/charts/kargo/resources/crds
KARGO_CRD_PROJECTS_SHA256=05ed175743aef3809bc996530e8cd0c30d7c2a3483d81d3b7a6c28c75a8a4ad8
KARGO_CRD_PROJECTCONFIGS_SHA256=07ffb296f078abd4c1970135e816820cb1e6ad7a4a50472bc465d1fe67e7d9d6
KARGO_CRD_STAGES_SHA256=cc96db3c3f8db26940efddaa0675dcf87ebb32f525f125d1dc79aba8d86e721c
KARGO_CRD_WAREHOUSES_SHA256=cc2ae2576bb0c8aaad7cf20c701f06e5dcd59a5dd779fa89bdc54aecd0894803

# Runtime controller artifacts. The chart's OCI manifest digest and downloaded
# archive checksum are both pinned: Helm verifies the former while the harness
# verifies the exact archive bytes before installing the local copy. All three
# required Kargo deployments use the same release image.
KARGO_CHART_REF=oci://ghcr.io/akuity/kargo-charts/kargo
KARGO_CHART_VERSION=1.9.10
KARGO_CHART_DIGEST=sha256:723fec1b787a7f6fa272bdbb4782050416bf59f62c305715bbb11b3a895fcbf3
KARGO_CHART_ARCHIVE_SHA256=ce2ae2eef5b628916582fb108c238d04d4c6b2b014ef819a982db402f239541c
KARGO_IMAGE_REPOSITORY=ghcr.io/akuity/kargo
KARGO_IMAGE_TAG=v1.9.10
KARGO_IMAGE_DIGEST=sha256:5de28676eb1ff4391beb6b78adcc6c78ed5d3e561a7109ff1a2618de0142d442

# Argo Rollouts executes Kargo's AnalysisRuns. The install manifest is pinned
# independently from its controller image, and the runtime rewrites the
# manifest to the digest reference before applying it.
ROLLOUTS_VERSION=v1.8.3
ROLLOUTS_MANIFEST_URL=https://github.com/argoproj/argo-rollouts/releases/download/v1.8.3/install.yaml
ROLLOUTS_MANIFEST_SHA256=6f4f581dab41450ca623a03d246156fa7fa79901f7f01693c5df66f7557fc145
ROLLOUTS_IMAGE_REPOSITORY=quay.io/argoproj/argo-rollouts
ROLLOUTS_IMAGE_TAG=v1.8.3
ROLLOUTS_IMAGE_DIGEST=sha256:2b7be18bd6a3ce627ce0ed63d49e9166720c0b3409404266bbadabd15474d28a

# Disposable Job-provider AnalysisTemplates use this one imported image. No
# verification Job is allowed to pull from a registry inside the cluster.
ANALYSIS_IMAGE_REPOSITORY=docker.io/library/busybox
ANALYSIS_IMAGE_TAG=1.36.1
ANALYSIS_IMAGE_DIGEST=sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
